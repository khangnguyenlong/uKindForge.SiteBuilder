@using Smidge;
@inherits UmbracoViewPage

@{
	Layout = null;
	DesignDetail design = null;
	if (ViewData["DesignDetail"] == null)
	{
		design = GetDesign();
		ViewData["DesignDetail"] = design;
	}
	else
    {
		design = ViewData["DesignDetail"] as DesignDetail;
    }
}

<!DOCTYPE html>
<html>
<head>
	<title>GoCoSiteBuilder</title>

	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<!--TODO-->
	<link rel="shortcut icon"
		  href="~/css/goco/"
		  type="image/svg" />

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600;700;800;900&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">

	<link rel="stylesheet" href="~/css/bundle.min.css" />

	@await Html.PartialAsync("~/Views/Partials/Design.cshtml", design)
</head>
<body>

	<!--Header-->
	@await Html.PartialAsync("~/Views/Partials/Header.cshtml")

	<!--Body-->
	<main id="content">
		@RenderBody()
	</main>

	<!--Footer-->
	@await Html.PartialAsync("~/Views/Partials/Footer.cshtml")

	<!--JS-->
	<script src="js-bundle"></script>
</body>
</html>

@functions {
	DesignDetail GetDesign()
	{
		var designList = Umbraco.ContentAtRoot()
					.FirstOrDefault(x => x.ContentType.Alias.InvariantEquals(DesignList.ModelTypeAlias)) as DesignList;
		return designList?.FirstChild<DesignDetail>();
	}
}