@inherits UmbracoViewPage<GoCoSiteBuilder.Models.Product>
@using GoCoSiteBuilder.Models
@using Umbraco.Cms.Core.Models

@{
    Layout = "Master.cshtml";
    var product = Model;
    var breadcrumbNodes = Model.Ancestors().Reverse().Append(Model);

    var mainImage = product.MainImage;
    var gallery = product.ProductGallery?.ToList() ?? new();
    var mainImageUrl = mainImage?.Url() ?? gallery.FirstOrDefault()?.Url() ?? "/img/no-image-available.png";

    // Filter: remove main image if it appears in gallery
    var filteredGallery = gallery.Where(x => x?.Url() != mainImage?.Url()).ToList();
}

<section class="container py-5">
    @await Html.PartialAsync("~/Views/Partials/Shared/_Breadcrumb.cshtml", breadcrumbNodes)
    <div class="row g-5">
        <!-- Image -->
        <div class="col-md-6">
            <div class="border rounded mb-3">
                <img id="mainProductImage" src="@mainImageUrl" alt="@product.ProductName" class="img-fluid rounded" />
            </div>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var image in filteredGallery)
                {
                    var thumbUrl = image.GetCropUrl(width: 60, height: 60);
                    <button type="button" class="border rounded overflow-hidden p-0" style="width: 60px; height: 60px;" onclick="document.getElementById('mainProductImage').src='@image.Url()'">
                        <img src="@thumbUrl" alt="Thumbnail" class="img-fluid h-100 w-100 object-fit-cover" />
                    </button>
                }
            </div>
        </div>

        <!-- Info -->
        <div class="col-md-6">
            <h1 class="h3 mb-4">@product.ProductName</h1>
            @if (product.ShortDescription != null)
            {
                <p class="lead">@product.ShortDescription</p>
            }
        </div>
    </div>

    @if (product.Details != null)
    {
        <div class="pt-5">
            @Html.GetBlockGridHtml(product.Details)
        </div>
    }
</section>
