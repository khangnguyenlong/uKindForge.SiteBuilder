@inherits UmbracoViewPage<ProductManagementPage>
@using GoCoSiteBuilder.Models
@using Umbraco.Cms.Core.Models.PublishedContent

@{
	Layout = "Master.cshtml";

	var rootNode = Model;

	var allCategories = rootNode.Children<ProductCategory>().ToList();
	var filteredProducts = allCategories.SelectMany(cat => cat.Children<Product>()).ToList();
	var breadcrumbNodes = Model.Ancestors().Reverse().Append(Model);
}

@await Html.PartialAsync("~/Views/Partials/Product/ProductCategory.cshtml", new ProductCategoryViewModel()
{
	ActiveCategoryId = null,
	Categories = allCategories,
	Products = filteredProducts,
	CategorySectionTitle = rootNode.CategorySectionTitle,
	EmptyCategoryMessage = rootNode.EmptyCategoryMessage,
	BreadcrumbNodes = breadcrumbNodes,
})