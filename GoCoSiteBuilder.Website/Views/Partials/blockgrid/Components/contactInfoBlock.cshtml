@inherits UmbracoViewPage<BlockGridItem<ContactInfoBlock>>

<div class="footer-block contact">
    <ul>
        @if (!string.IsNullOrWhiteSpace(Model.Content?.Address))
        {
            <li>
                <i class="lni lni-map-marker"></i> @Model.Content.Address
            </li>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Content?.Phone))
        {
            <li><i class="lni lni-phone-set"></i> @Model.Content.Phone</li>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Content?.Email))
        {
            <li><i class="lni lni-envelope"></i> @Model.Content.Email</li>
        }
    </ul>
</div>
