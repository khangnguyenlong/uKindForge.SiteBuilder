@inherits UmbracoViewPage<BlockGridItem<CardStyle2Block, CardStyle2BlockSettings>>
@inject DesignHelper DesignHelper

<div class="card-area">
    <div class="single-card card-style">
        <div class="row no-gutters @CssClassHelper.GetVerticalContentAlign(Model.Settings.ContentAlign)">
            @if (Model.Settings.Reverse)
            {
                <div class="col-sm-6">
                    @{
                        @await Html.PartialImageLinkAsync(new ImageViewModel(Model.Content.Image))
                    }
                </div>
                <div class="col-sm-6">
                    @{
                        await RenderContentAsync();
                    }
                </div>
            }
            else
            {
                <div class="col-sm-6">
                    @{
                        await RenderContentAsync();
                    }
                </div>
                <div class="col-sm-6">
                    @{
                        @await Html.PartialImageLinkAsync(new ImageViewModel(Model.Content.Image))
                    }
                </div>
            }
        </div>
    </div>
</div>

@functions {
    async Task RenderContentAsync()
    {
        <div class="card-content @CssClassHelper.GetTextAlign(Model.Settings.ContentAlign) @DesignHelper.GetBackgroundClass(Model.Settings.Color)">
            @await Html.PartialHeadingAsync(new HeadingViewModel(Model.Content.Title))
            @await Html.PartialTextAsync(new TextViewModel(Model.Content.Description))
            @await Html.PartialButtonLinkAsync(new ButtonViewModel { Buttons = Model.Content.Buttons })
        </div>
    }
}