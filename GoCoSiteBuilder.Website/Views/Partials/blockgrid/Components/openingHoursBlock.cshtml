@inherits UmbracoViewPage<BlockGridItem<OpeningHoursBlock>>

<div class="footer-block">
    <div class="opening-hours">
        @await Html.PartialHeadingAsync(new HeadingViewModel(Model.Content.Heading))
        @if (Model.Content?.OpeningHours != null && Model.Content.OpeningHours.Any())
        {
            <ul>
                @foreach (var openingHoursItem in Model.Content.OpeningHours)
                {
                    @if (openingHoursItem.Content is not OpeningHour openingHour || openingHour == null) continue;

                    <li class="opening-hours__list-item" tabindex="0" aria-label="@openingHour.Day">
                        <span class="day">@openingHour.Day</span>
                        <span class="hours">@openingHour.Time</span>
                    </li>
                }
            </ul>
        }
    </div>
</div>