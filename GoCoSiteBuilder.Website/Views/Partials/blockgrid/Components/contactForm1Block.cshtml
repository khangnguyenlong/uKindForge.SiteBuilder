@inherits UmbracoViewPage<BlockGridItem<ContactForm1Block, ContactFormBlockSettings>>
@inject DesignHelper DesignHelper

@{
	var fullNameLabel = string.IsNullOrEmpty(Model.Settings?.FullNameLabel) ? "Full Name" : Model.Settings.FullNameLabel;
	var emailAddressLabel = string.IsNullOrEmpty(Model.Settings?.EmailAddressLabel) ? "Email Address" : Model.Settings.EmailAddressLabel;
	var phoneNumberLabel = string.IsNullOrEmpty(Model.Settings?.PhoneNumberLabel) ? "Phone Number" : Model.Settings.PhoneNumberLabel;
	var subjectLabel = string.IsNullOrEmpty(Model.Settings?.SubjectLabel) ? "Subject" : Model.Settings.SubjectLabel;
	var messageLabel = string.IsNullOrEmpty(Model.Settings?.MessageLabel) ? "Your Message" : Model.Settings.MessageLabel;
	var submitButtonLabel = string.IsNullOrEmpty(Model.Settings?.SubmitButtonLabel) ? "Send Message" : Model.Settings.SubmitButtonLabel;
}

<div class="contact-form-1-block block contact-area @DesignHelper.GetBackgroundClass(Model.Settings?.ContentColor)">
	<div class="container">
		<div class="row">
			<div class="col-xl-7 col-lg-8">
				<div id="contactForm" class="contact-form form-style-four">
					@using (Html.BeginUmbracoForm("SubmitContactForm", "ContactFormSurface", FormMethod.Post))
					{
						<div class="row">
							<div class="col-md-6">
								<div class="form-input">
									<label>@fullNameLabel</label>
									<div class="input-items default">
										<i class="lni lni-user"></i>
										<input name="Name" required type="text" />
									</div>
								</div>
								<!-- form input -->
							</div>
							<div class="col-md-6">
								<div class="form-input">
									<label>@phoneNumberLabel</label>
									<div class="input-items default">
										<i class="lni lni-phone"></i>
										<input name="Phone" required type="text" />
									</div>
								</div>
								<!-- form input -->
							</div>
							<div class="col-md-12">
								<div class="form-input  mt-15">
									<label>@emailAddressLabel</label>
									<div class="input-items default">
										<i class="lni lni-envelope"></i>
										<input name="Email" required type="email" />
									</div>
								</div>
								<!-- form input -->
							</div>
							<div class="col-md-12">
								<div class="form-input mt-15">
									<label>@messageLabel</label>
									<div class="input-items default">
										<i class="lni lni-pencil-alt"></i>
										<textarea name="Message" required></textarea>
									</div>
								</div>
								<!-- form input -->
							</div>
							<div class="col-md-12">
								<div class="single-form mt-15">
									<div class="input-form rounded-buttons">
										<button class="btn @DesignHelper.GetButtonClass(Model.Settings?.SubmitButtonStyle) rounded-full"
												type="submit">
											@submitButtonLabel
										</button>
										@if (TempData["Success"] != null && !string.IsNullOrEmpty(Model.Settings?.SuccessMessage))
										{
											<p class="mt-2">@Model.Settings.SuccessMessage</p>
										}
									</div>
								</div>
								<!-- single form -->
							</div>
						</div>
						<!-- row -->
					}
				</div>
				<!-- contact form -->
			</div>
			<div class="col-xl-4 col-lg-4 col-md-6 col-sm-8 offset-xl-1">
				@await Html.PartialTextAsync(new TextViewModel(Model.Content.Description))
				<div class="contact-info">
					<ul class="info">
						@if (!string.IsNullOrEmpty(Model.Content.Address))
						{
							<li>
								<div class="single-info">
									<div class="info-icon">
										<i class="lni lni-map-marker"></i>
									</div>
									<div class="info-content">
										<p class="text">
											@Model.Content.Address
										</p>
									</div>
								</div>
								<!-- single info -->
							</li>
						}
						@if (!string.IsNullOrEmpty(Model.Content.Mobile))
						{
							<li>
								<div class="single-info">
									<div class="info-icon">
										<i class="lni lni-phone"></i>
									</div>
									<div class="info-content">
										<p class="text">@Model.Content.Mobile</p>
									</div>
								</div>
								<!-- single info -->
							</li>
						}
						@if (!string.IsNullOrEmpty(Model.Content.Telephone))
						{
							<li>
								<div class="single-info">
									<div class="info-icon">
										<i class="lni lni-phone-set"></i>
									</div>
									<div class="info-content">
										<p class="text">@Model.Content.Telephone</p>
									</div>
								</div>
								<!-- single info -->
							</li>
						}
						@if (!string.IsNullOrEmpty(Model.Content.Email))
						{
							<li>
								<div class="single-info">
									<div class="info-icon">
										<i class="lni lni-envelope"></i>
									</div>
									<div class="info-content">
										<p class="text">@Model.Content.Email</p>
									</div>
								</div>
								<!-- single info -->
							</li>
						}
					</ul>
					<div class="mt-3">
						@await Html.PartialLineIconLinkListAsync(Model.Content.SocialIcons)
					</div>
				</div>
				<!-- contact-info -->
			</div>
		</div>
		<!-- row -->
	</div>
	<!-- container -->
</div>

@if (TempData["Success"] != null)
{
	<script>
		window.addEventListener("load", function () {
			const form = document.getElementById("contactForm");
			if (form) {
				form.scrollIntoView({ behavior: "smooth" });
			}
		});
	</script>
}