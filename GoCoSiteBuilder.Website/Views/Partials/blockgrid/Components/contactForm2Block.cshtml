@inherits UmbracoViewPage<BlockGridItem<ContactForm2Block, ContactFormBlockSettings>>
@inject DesignHelper DesignHelper
<!--TODO implement submit form -->
<section class="contact-area contact-area-two">
	<div class="container">
		<!-- row -->
		<div class="row">
			<div class="col-xl-5 col-lg-6">
				<div class="contact-two">
					@await Html.PartialTextAsync(new TextViewModel(Model.Content.Description))
                   <ul class="contact-info">
						@if (!string.IsNullOrEmpty(Model.Content.Address))
						{
							<li><i class="lni lni-money-location"></i> @Model.Content.Address</li>
						}
						@if (!string.IsNullOrEmpty(Model.Content.Mobile))
						{
							<li><i class="lni lni-phone"></i> @Model.Content.Mobile</li>
						}
						@if (!string.IsNullOrEmpty(Model.Content.Telephone))
						{
							<li><i class="lni lni-phone-set"></i> @Model.Content.Telephone</li>
						}
						@if (!string.IsNullOrEmpty(Model.Content.Email))
						{
							<li><i class="lni lni-envelope"></i> @Model.Content.Email</li>
						}
					</ul>
				</div>
				<!-- contact two -->
			</div>
			<div class="col-xl-6 col-lg-6 offset-xl-1">
				<div class="contact-form form-style-one">
					<form action="#">
						<div class="form-input">
							<label>Name</label>
							<div class="input-items default">
								<input type="text" placeholder="Name" />
								<i class="lni lni-user"></i>
							</div>
						</div>
						<!-- form input -->
						<div class="form-input">
							<label>Email</label>
							<div class="input-items default">
								<input type="text" placeholder="Email" />
								<i class="lni lni-envelope"></i>
							</div>
						</div>
						<!-- form input -->
						<div class="form-input">
							<label>Massage</label>
							<div class="input-items default">
								<textarea placeholder="Massage"></textarea>
								<i class="lni lni-pencil-alt"></i>
							</div>
						</div>
						<!-- form input -->
						<div class="form-input standard-buttons">
							<button class="btn primary-btn square">Submit</button>
						</div>
						<!-- form input -->
					</form>
				</div>
				<!-- contact form -->
			</div>
		</div>
		<!-- row -->
	</div>
	<!-- container -->
</section>