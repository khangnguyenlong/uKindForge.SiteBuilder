@inherits UmbracoViewPage<BlockGridItem<SlidersStyle1Block, SlidersStyle1BlockSettings>>

@{
    if (Model.Content == null || Model.Content.SliderItems == null || !Model.Content.SliderItems.Any()) return;
    var carouselId = $"carousel-{Model.Content.Key}";
}
<div class="@CssClassHelper.GetFullWithClass(Model.Settings?.FullWidth) slider-area slider-one">
    <div class="bd-example">
        <div id="@carouselId" class="carousel slide" data-bs-ride="carousel">
            <ol class="carousel-indicators">
                @for (int i = 0; i < Model.Content.SliderItems.Count; i++)
                {
                    var active = i == 0 ? "active" : "";
                    <li data-bs-target="#@carouselId" data-bs-slide-to="@i" class="@active"></li>
                }
            </ol>

            @{await RenderSliderItem(Model.Content.SliderItems);}

            <a class="carousel-control-prev"
               href="#@carouselId"
               role="button"
               data-bs-slide="prev">
                <i class="lni lni-chevron-left"></i>
            </a>

            <a class="carousel-control-next"
               href="#@carouselId"
               role="button"
               data-bs-slide="next">
                <i class="lni lni-chevron-right"></i>
            </a>
        </div>
        <!-- carousel -->
    </div>
    <!-- bd-example -->
</div>

@functions
{
    async Task RenderSliderItem(BlockListModel sliderItemBlockList)
    {
        <div class="carousel-inner">
            @for (int i = 0; i < sliderItemBlockList.Count; i++)
            {
                var sliderItem = sliderItemBlockList[i];
                if (sliderItem?.Content is not SliderStyle1 slider) continue;
                var settings = sliderItem.Settings as SliderStyle1Settings;

                <div class="carousel-item bg_cover @(i == 0 ? "active" : "") @CssClassHelper.GetBackgroundClass(settings.BgColor)"
                     style="background-image: url(@slider.Image?.GetCropUrl(width: 1920));">
                    <div class="carousel-caption">
                        <div class="container">
                            <div class="row @CssClassHelper.GetJustifyContentAlign(settings.ContentAlign)">
                                <div class="col-xl-6 col-lg-7 col-sm-10">
                                    @await Html.PartialHeadingAsync(new HeadingViewModel(slider.Heading))
                                    @await Html.PartialTextAsync(new TextViewModel(slider.Description))
                                    @await Html.PartialButtonLinkAsync(new ButtonViewModel { Buttons = slider?.Buttons })
                                </div>
                            </div>
                            <!-- row -->
                        </div>
                        <!-- container -->
                    </div>
                    <!-- carousel caption -->
                </div>
            }
        </div>
    }
}