@inherits UmbracoViewPage<BlockGridItem<LogoLinksBlock>>

@{
    if (Model.Content == null) return;
}

<div class="footer-block">
    <div class="logo-link">
        @await Html.PartialHeadingAsync(new HeadingViewModel(Model.Content.Title))
        @if (Model.Content?.LogoLinks != null && Model.Content.LogoLinks.Any())
        {
            @foreach (var logoLinkItem in Model.Content.LogoLinks)
            {
                @if (logoLinkItem.Content is not LogoLink logoLink || logoLink == null) continue;

                @await Html.PartialImageLinkAsync(new ImageViewModel(@logoLink.Logo) 
                { 
                    CropWidth = 150, CropHeight = 50, 
                    ImageAlt = @logoLink.Link?.Name, 
                    Link = @logoLink.Link, 
                    CssStyle = "max-height: 50px; max-width: 150px" 
                })
            }
        }
    </div>
</div>
