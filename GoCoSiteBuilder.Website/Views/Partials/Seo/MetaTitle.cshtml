@inherits UmbracoViewPage

@{
    var pageTitle = Model.Value<string>("pageTitle");
    if (string.IsNullOrWhiteSpace(pageTitle))
    {
        pageTitle = Model.Name;
    }

    var siteName = Model
        .AncestorsOrSelf()
        .FirstOrDefault(x => x.ContentType.Alias == GlobalSettings.ModelTypeAlias)
        ?.Value<string>("siteName") ?? string.Empty;

    var fullTitle = !string.IsNullOrWhiteSpace(siteName) ? $"{pageTitle} | {siteName}" : pageTitle;
}

<title>@fullTitle</title>
