@inherits UmbracoViewPage<BlockGridItem<LineBlock>>
@inject DesignHelper DesignHelper;
@{
	var horizontal = Model.Content?.Horizontal?.Content;
	var borderPx = (horizontal == null || horizontal.LineWidth == 0) ? 1 : horizontal.LineWidth;
	var borderColor = string.IsNullOrWhiteSpace(horizontal?.LineColor) ? "000" : horizontal.LineColor;
	var borderStyle = string.IsNullOrWhiteSpace(horizontal?.LineStyle) ? "none" : horizontal.LineStyle.ToLower();

	var style = horizontal?.IsOverrideDesign == true ?
		$"border-top-color:{borderColor};border-top-width:{borderPx}px;border-top-style:{borderStyle};{horizontal?.CustomCss}" : "";

	var design = DesignHelper.GetDesign();
	var customCss = design?.LayoutSettings?.HorizontalLine?.CustomCSS;
}

<div class="block line-block" style="@style @customCss"></div>