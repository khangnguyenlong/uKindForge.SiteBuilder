@inherits UmbracoViewPage<BlockGridItem<VideoBlock>>
@{
    var video = Model.Content.Video;
    var autoplay = Model.Content.IsAutoplay ? "autoplay" : "";
    var muted = Model.Content.IsMuted ? "muted" : "";
    var loop = Model.Content.IsLoop ? "loop" : "";

    //TODO apply url & overlay
    if (video is not null)
    {
        <video class="w-100"
            controls preload="metadata" src="@video.Url()"
               @autoplay @muted @loop>
        </video>
    }
}
