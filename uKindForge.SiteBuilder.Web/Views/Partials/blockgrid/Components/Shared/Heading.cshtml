@inherits UmbracoViewPage<HeadingViewModel>

@if (Model?.Heading?.HeadingText?.IsNullOrWhiteSpace() == false)
{
    <div class="block heading-block">
        @if (Model.Heading.Link?.Url?.IsNullOrWhiteSpace() == false)
        {
            <a href="@Model.Heading.Link.Url" target="@Model.Heading.Link.Target">
                @{
                    RenderHeading();
                }
            </a>
        }
        else
        {
            RenderHeading();
        }
    </div>
}

@functions {
    void RenderHeading()
    {
		// var styleBold = Model.Heading.Bold ? "bold" : "";
        <@Model.Heading.HeadingTag class="@Model.Heading.HeadingTag @CssClassHelper.GetTextAlign(@Model.Heading.Align, applyDefaultValue: false) @Model.CssClass">@Model.Heading.HeadingText</@Model.Heading.HeadingTag>
    }
}
