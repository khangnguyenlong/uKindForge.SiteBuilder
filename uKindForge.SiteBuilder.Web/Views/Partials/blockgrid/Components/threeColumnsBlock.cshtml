@inherits UmbracoViewPage<BlockGridItem<ThreeColumnsBlock>>

@{
    var layoutSettings = new LayoutSettingsViewModel
    {
        BackgroundType = Model.Content.BackgroundType,
        SectionColorStyle = Model.Content.BackgroundColor,
        BackgroundImage = Model.Content.BackgroundImage,
        BackgroundImageUrl = Model.Content.BackgroundImageUrl,
        BackgroundVideo = Model.Content.BackgroundVideo,
        BackgroundVideoUrl = Model.Content.BackgroundVideoUrl,
        FullWidth = Model.Content.FullWidth,
        FullScreen = Model.Content.FullScreen,
        Top = (int)Model.Content.Top,
        Bottom = (int)Model.Content.Bottom,

        EnableOverlay = Model.Content.EnableOverlay,
        OverlayColor = Model.Content.OverlayColor,
        OverlayOpacity = Model.Content.OverlayOpacity
    };
}

<section-layout info="layoutSettings">
    @await Html.GetPreviewBlockGridItemAreasHtmlAsync(Model)
</section-layout>