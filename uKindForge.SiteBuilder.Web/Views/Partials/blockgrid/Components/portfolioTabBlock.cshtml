@inherits UmbracoViewPage<BlockGridItem<PortfolioTabBlock>>

@{
	if (!Model.Content.PortfolioItems.Any()) return;
	var tabItems = Model.Content.PortfolioItems;
}

<div class="portfolio-area portfolio-two">
	<div class="container">
		<div class="row">
			<div class="col-lg-12">
				<div class="portfolio-menu text-center">
					@foreach (var item in tabItems)
					{
						var tabItem = item.Content.SafeCast<PortfolioTabItem>();
						if (tabItem == null) continue;
						var settings = item.Settings.SafeCast<PortfolioTabItemSettings>();

						var isFirstItem = tabItem.Key == tabItems[0].Content.Key;
						<button data-filter="@(settings?.ShowAllItems == true ? "all" : tabItem.Key)" class="@(isFirstItem ? "active" : "")">@tabItem.TabTitle</button>
					}
				</div>
				<!-- portfolio menu -->
			</div>
		</div>
		<!-- row -->
		<div class="row grid">
			@foreach (var item in tabItems)
			{
				var tabItem = item.Content.SafeCast<PortfolioTabItem>();
				if (tabItem == null) continue;

				@foreach (var portfolioBlockItem in tabItem.PortfolioItems)
				{
					var portfolioItem = portfolioBlockItem.Content.SafeCast<PortfolioItem>();
					if (portfolioItem == null) continue;

					<div class="col-lg-4 col-sm-6" data-filter="@tabItem.Key">
						<div class="portfolio-style-two text-center">
							<div class="portfolio-image">
								@await Html.PartialImageLinkAsync(new ImageViewModel(portfolioItem.Image))
							</div>
							<div class="portfolio-overlay d-flex align-items-center">
								<div class="portfolio-content">
									<div class="portfolio-icon">
										<a class="image-popup glightbox2"
										   href="../assets/images/portfolio/portfolio-2/pf2.jpg">
											<i class="lni lni-zoom-in"></i>
										</a>
									</div>
									<div class="portfolio-icon">
										<a href="javascript:void(0)">
											<i class="lni lni-link"></i>
										</a>
									</div>
									<div class="portfolio-text">
										@await Html.PartialHeadingAsync(new HeadingViewModel(portfolioItem.Title, cssClass: "portfolio-title"))
										@await Html.PartialTextAsync(new TextViewModel(portfolioItem.Description))
									</div>
								</div>
							</div>
						</div>
						<!-- single portfolio -->
					</div>
				}
			}
		</div>
	</div>
	<!-- container -->
</div>