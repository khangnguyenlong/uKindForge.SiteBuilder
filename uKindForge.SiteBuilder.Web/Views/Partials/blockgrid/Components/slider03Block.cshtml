@inherits UmbracoViewPage<BlockGridItem<Slider03Block, SliderBlockSettings>>
@inject DesignHelper DesignHelper

@{
	if (Model.Content == null) return;
}

<div class="testimonial testimonial-one @DesignHelper.GetBackgroundClass(Model.Settings?.Color)">
	<!--======  Start Section Title Seven ======-->
	<div class="section-title-seven">
		<div class="container">
			<div class="row">
				<div class="col-12">
					<div class="section-title align-center">
						@await Html.PartialHeadingAsync(new HeadingViewModel(Model.Content.Title))
						@await Html.PartialTextAsync(new TextViewModel(Model.Content.Description))
					</div>
				</div>
			</div>
		</div>
		<!-- container -->
	</div>
	<!--====== End Section Title Seven ======-->
	<div class="container">
		<div class="testimonial-one-wrapper">
			<div class="row justify-content-center">
				<div class="col-md-9 col-lg-12">
					<div class="row testimonial-one-active">
						@foreach (var item in Model.Content.Items)
						{
							var sliderItem = item.Content.SafeCast<SliderItem>();
							if (sliderItem == null) continue;
							var sliderItemSettings = item.Settings.SafeCast<SliderItemSettings>();
							var lineIcon = sliderItem.QuoteIcon?.Content;

							<div class="col-lg-4">
								<div class="single-testimonial text-center @DesignHelper.GetBackgroundClass(sliderItemSettings?.Color)">
									<div class="testimonial-image">
										@await Html.PartialImageLinkAsync(new ImageViewModel(sliderItem.Image))
										@await Html.PartialLineIconAsync(new LineIconViewModel(lineIcon, defaultIcon: "lni-quotation", cssClass: "quote-icon"))
									</div>
									<div class="testimonial-content">
										@await Html.PartialTextAsync(new TextViewModel(sliderItem.Description))
										@await Html.PartialHeadingAsync(new HeadingViewModel(sliderItem.AuthorName, "author-name"))
										@await Html.PartialSubheadingAsync(new HeadingViewModel(sliderItem.SubTitle, "sub-title"))
									</div>
								</div>
								<!-- single testimonial -->
							</div>
						}
					</div>
					<!-- row -->
				</div>
			</div>
		</div>
	</div>
	<!-- container -->
</div>