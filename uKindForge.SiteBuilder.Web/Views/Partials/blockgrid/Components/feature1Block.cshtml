@inherits UmbracoViewPage<BlockGridItem<Feature1Block, Feature1BlockSettings>>
@inject DesignHelper DesignHelper

@{
    if (Model.Content == null) return;
    var featureItems = Model.Content.FeatureItems;
}

<div class="feature-block">
    @if (featureItems?.Any() == true)
    {
        <div class="card-area">
            <div class="row justify-content-center">
                <div class="col-lg-6">
                    <div class="section-title text-center">
                        @await Html.PartialHeadingAsync(new HeadingViewModel(Model.Content.Title))
                        @await Html.PartialTextAsync(new TextViewModel(Model.Content.Description))
                    </div>
                    <!-- row -->
                </div>
            </div>
            <div class="row justify-content-center">
                @foreach (var featureItem in featureItems)
                {
                    var feature = featureItem.Content.SafeCast<FeatureItem>();
                    var featureSettings = featureItem.Settings.SafeCast<FeatureItemSettings>();
                    <div class="@CssClassHelper.GetColClass(Model.Settings.Columns.IsNullOrWhiteSpace() ? "3" : Model.Settings.Columns)">
                        <div class="single-card card-style-one">
                            @if (featureSettings.Reverse)
                            {
                                await RenderContentAsync(feature, featureSettings);
                                @await Html.PartialImageLinkAsync(new ImageViewModel(feature.Image))
                            }
                            else
                            {
                                @await Html.PartialImageLinkAsync(new ImageViewModel(feature.Image))
                                await RenderContentAsync(feature, featureSettings);
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@functions {
    async Task RenderContentAsync(FeatureItem feature, FeatureItemSettings settings)
    {
        <div class="card-content @CssClassHelper.GetTextAlign(Model.Settings.ContentAlign) @DesignHelper.GetBackgroundClass(settings.Color)">
            @await Html.PartialHeadingAsync(new HeadingViewModel(feature.Title))
            @await Html.PartialTextAsync(new TextViewModel(feature.Description))
            @await Html.PartialButtonLinkAsync(new ButtonViewModel { Buttons = feature.Buttons })
        </div>
    }
}
