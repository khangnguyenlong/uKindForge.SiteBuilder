@inherits UmbracoViewPage<BlockGridItem<EmbedBlock, EmbedBlockSettings>>
@inject DesignHelper DesignHelper;

@{
    var embedCode = Model.Content?.EmbedCode;
    if (string.IsNullOrEmpty(embedCode)) return;

    var defaultValue = "2/1";
    var selectedLabel = Model.Settings?.AspectRatio ?? defaultValue;
    var hasRatio = !string.IsNullOrWhiteSpace(Model.Settings?.AspectRatio) && selectedLabel != "auto";

    var aspectRatioMap = new Dictionary<string, string>
    {
        ["16:9 (YouTube default)"] = "16/9",
        ["4:3 (Classic video)"] = "4/3",
        ["21:9 (Ultra-wide)"] = "21/9",
        ["1:1 (Square)"] = "1/1",
        ["3:2 (Photography)"] = "3/2",
        ["9:16 (Portrait video)"] = "9/16",
        ["2:1 (Banner)"] = "2/1",
        ["1:2 (Tall embed)"] = "1/2",
        ["auto"] = "auto"
    };

    var aspectRatio = aspectRatioMap.TryGetValue(selectedLabel, out var mappedValue) ? mappedValue : defaultValue;
}

<div class="block embed-block @CssClassHelper.GetTextAlign(Model.Settings?.Align)" 
    style="@(hasRatio ? $"aspect-ratio: {aspectRatio};" : "")">
    @Html.Raw(embedCode)
</div>
