@inherits UmbracoViewPage<HomePage>
@inject DesignHelper DesignHelper

@{
	var design = DesignHelper.GetDesign();
	var headerDesktopClass = design?.LayoutSettings?.HeaderDesktop?.HeaderAlwaysOnTop == true ? "header-desktop__sticky" : "";
	var headerMobileClass = design?.LayoutSettings?.HeaderMobile?.HeaderAlwaysOnTop == true ? "header-mobile__sticky" : "";
}

<header id="header" class="header-block @headerDesktopClass @headerMobileClass">
    @await Html.GetBlockGridHtmlAsync(Model.PageHeaderContent)
</header>